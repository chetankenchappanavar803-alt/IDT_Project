{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/peers",
      "dest": "/api/peers.js"
    },
    {
      "src": "/api/exchanges/(.*)",
      "dest": "/api/exchanges.js?id=$1"
    },
    {
      "src": "/api/exchanges",
      "dest": "/api/exchanges.js"
    },
    {
      "src": "/api/ai",
      "dest": "/api/ai.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
